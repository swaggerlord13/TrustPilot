# Copy this file to server/.env and fill in real values.
# Never commit server/.env — it holds secrets.

# --- Core ---
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/trustpilot
JWT_SECRET=a-long-random-string

# Frontend address (used for CORS and links in emails)
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Secret required by PUT /api/auth/make-admin
ADMIN_SECRET=another-long-random-string

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxx

# --- Image uploads (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Sign in with Google ---
# OAuth "Web application" client ID from Google Cloud > Google Auth Platform > Clients.
# Must be the SAME value as the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# --- Sign in with Twitter/X ---
TWITTER_CLIENT_ID=

# --- Google Places API (New) ---
# Server-only key, restricted to "Places API (New)". Never expose it to the frontend.
GOOGLE_PLACES_API_KEY=
